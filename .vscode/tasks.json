{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build ( TSC : Project refs )",
      "type": "shell",
      "command": "npx tsc -b",
      "problemMatcher": ["$tsc"],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "type": "shell",
      "label": "Run test task",
      "command": "npm run start",
      "group": { "kind": "test", "isDefault": true }
    }
  ]
}
